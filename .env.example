# Optional: create a free form at https://formspree.io/create and paste only its form ID.
# Example endpoint: https://formspree.io/f/yourformid -> NEXT_PUBLIC_FORMSPREE_ID=yourformid
NEXT_PUBLIC_FORMSPREE_ID=

# Set this to the public URL when deploying outside Vercel so social previews use the correct host.
NEXT_PUBLIC_SITE_URL=
